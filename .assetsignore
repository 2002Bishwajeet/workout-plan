# .assetsignore — controls what the static-site Worker (root wrangler.jsonc) uploads.
# wrangler uploads the assets directory from DISK, not from git, so this also keeps
# local-only files (.env, .wrangler cache, .git history) from ever being served.
# Only index.html, site.webmanifest, css/, js/, and assets/ should ship to the web.
#
# NOTE: patterns follow .gitignore rules — an UNANCHORED name matches at ANY depth.
# Root-only entries are anchored with a leading "/" so that e.g. "/data" excludes the
# top-level data/ but NOT js/data/ (which holds the app's programme modules). An
# unanchored "data" would 404 js/data/*.js and hang the app on the boot screen.

# match anywhere (these never collide with site files)
.git
.DS_Store
.wrangler
.dev.vars*
.env*
node_modules

# root-only: version control & CI config
/.github
/.gitignore

# root-only: server-side / non-site config & source
/worker
/wrangler.jsonc

# root-only: repo docs & training data (state is served via the API Worker)
/data
/docs
/CLAUDE.md
/README.md
/LICENSE

# root-only: stray / legacy
/protocol
